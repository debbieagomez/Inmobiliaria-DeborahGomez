@model IEnumerable<Inmobiliaria_DeborahGomez.Models.InmuebleConReservas>

@{
    ViewData["Title"] = "Inmuebles más reservados";
    int dias = ViewBag.Dias ?? 365;
    int pagina = ViewBag.Pagina ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 0;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Inmuebles más reservados</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver a informes</a>
    </div>

    <form asp-action="InmueblesMasReservados" method="get" class="row g-2 mb-4">
        <div class="col-md-8">
            <input type="number" name="dias" id="dias" value="@dias" min="1" class="form-control" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-outline-primary">Aplicar período</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No hay inmuebles con reservas en el período seleccionado.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Dirección</th>
                        <th>Propietario</th>
                        <th>Tipo</th>
                        <th>Cantidad de reservas</th>
                        <th>Última reserva</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Inmueble.Direccion</td>
                            <td>@item.Inmueble.propietarioNombre</td>
                            <td>@item.Inmueble.TipoNombre</td>
                            <td>@item.CantidadReservas</td>
                            <td>@item.UltimaFecha.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (totalPaginas > 1)
    {
        <nav class="mt-3" aria-label="Paginación de inmuebles más reservados">
            <ul class="pagination">
                @if (pagina > 1)
                {
                    <li class="page-item"><a class="page-link" asp-action="InmueblesMasReservados" asp-route-dias="@dias" asp-route-pagina="@(pagina - 1)">Anterior</a></li>
                }
                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == pagina ? "active" : "")"><a class="page-link" asp-action="InmueblesMasReservados" asp-route-dias="@dias" asp-route-pagina="@i">@i</a></li>
                }
                @if (pagina < totalPaginas)
                {
                    <li class="page-item"><a class="page-link" asp-action="InmueblesMasReservados" asp-route-dias="@dias" asp-route-pagina="@(pagina + 1)">Siguiente</a></li>
                }
            </ul>
        </nav>
    }
</div>
