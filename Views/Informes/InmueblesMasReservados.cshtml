@model IEnumerable<Inmobiliaria_DeborahGomez.Models.InmuebleConReservas>

@{
    ViewData["Title"] = "Inmuebles más reservados";
    int dias = ViewBag.Dias;
    int pagina = ViewBag.Pagina;
    int totalPaginas = ViewBag.TotalPaginas;
}

<h2>Inmuebles más reservados</h2>

<form asp-action="InmueblesMasReservados" method="get" class="mb-3">
    <label for="dias">Últimos</label>
    <input type="number" name="dias" id="dias" value="@dias" min="1" style="width: 80px;" />
    <label for="dias">días</label>
    <button type="submit">Aplicar</button>
</form>

@if (!Model.Any())
{
    <p>No hay inmuebles con reservas en el período seleccionado.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Dirección</th>
                <th>Propietario</th>
                <th>Tipo</th>
                <th>Cantidad de reservas</th>
                <th>Última reserva</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.Inmueble.Direccion
                    </td>

                    <td>
                        @item.Inmueble.propietarioNombre
                    </td>

                    <td>
                        @item.Inmueble.TipoNombre
                    </td>

                    <td>
                        @item.CantidadReservas
                    </td>

                    <td>
                        @item.UltimaFecha.ToString("dd/MM/yyyy")
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        @if (pagina > 1)
        {
            <a asp-action="InmueblesMasReservados" asp-route-dias="@dias" asp-route-pagina="@(pagina - 1)">Anterior</a>
        }
        <span> Página @pagina de @totalPaginas </span>
        @if (pagina < totalPaginas)
        {
            <a asp-action="InmueblesMasReservados" asp-route-dias="@dias" asp-route-pagina="@(pagina + 1)">Siguiente</a>
        }
    </div>
}

<a asp-action="Index">Volver a Informes</a>