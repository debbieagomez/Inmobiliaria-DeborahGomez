@model IEnumerable<Inmobiliaria_DeborahGomez.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles disponibles entre fechas";
    DateTime? fechaDesde = ViewBag.FechaDesde;
    DateTime? fechaHasta = ViewBag.FechaHasta;
    int pagina = ViewBag.Pagina;
    int totalPaginas = ViewBag.TotalPaginas;
}

<h2>Inmuebles disponibles entre dos fechas</h2>

<form asp-action="InmueblesDisponiblesEntreFechas" method="get" class="mb-3">
    <label for="fechaDesde">Desde:</label>
    <input type="date" name="fechaDesde" id="fechaDesde" value="@(fechaDesde?.ToString("yyyy-MM-dd"))" />

    <label for="fechaHasta">Hasta:</label>
    <input type="date" name="fechaHasta" id="fechaHasta" value="@(fechaHasta?.ToString("yyyy-MM-dd"))" />

    <button type="submit">Buscar</button>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="text-danger">
        @foreach (var error in ViewData.ModelState.SelectMany(kvp => kvp.Value!.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}

@if (fechaDesde == null || fechaHasta == null)
{
    <p>Elegí ambas fechas para buscar inmuebles disponibles.</p>
}
else if (!Model.Any())
{
    <p>No hay inmuebles disponibles en ese rango de fechas.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Dirección</th>
                <th>Propietario</th>
                <th>Tipo</th>
                <th>Precio por día</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inmueble in Model)
            {
                <tr>
                    <td>@inmueble.Direccion</td>
                    <td>@inmueble.propietarioNombre</td>
                    <td>@inmueble.TipoNombre</td>
                    <td>@inmueble.PrecioPorDia</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        @if (pagina > 1)
        {
            <a asp-action="InmueblesDisponiblesEntreFechas"
               asp-route-fechaDesde="@fechaDesde?.ToString("yyyy-MM-dd")"
               asp-route-fechaHasta="@fechaHasta?.ToString("yyyy-MM-dd")"
               asp-route-pagina="@(pagina - 1)">Anterior</a>
        }
        <span> Página @pagina de @totalPaginas </span>
        @if (pagina < totalPaginas)
        {
            <a asp-action="InmueblesDisponiblesEntreFechas"
               asp-route-fechaDesde="@fechaDesde?.ToString("yyyy-MM-dd")"
               asp-route-fechaHasta="@fechaHasta?.ToString("yyyy-MM-dd")"
               asp-route-pagina="@(pagina + 1)">Siguiente</a>
        }
    </div>
}

<a asp-action="Index">Volver a Informes</a>