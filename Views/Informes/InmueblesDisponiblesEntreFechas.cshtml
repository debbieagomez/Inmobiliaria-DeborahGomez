@model IEnumerable<Inmobiliaria_DeborahGomez.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles disponibles entre fechas";
    DateTime? fechaDesde = ViewBag.FechaDesde;
    DateTime? fechaHasta = ViewBag.FechaHasta;
    int pagina = ViewBag.Pagina ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 0;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Inmuebles disponibles entre fechas</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver a informes</a>
    </div>

    <form asp-action="InmueblesDisponiblesEntreFechas" method="get" class="row g-2 mb-4">
        <div class="col-md-4">
            <label for="fechaDesde" class="form-label">Desde</label>
            <input type="date" name="fechaDesde" id="fechaDesde" value="@(fechaDesde?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-md-4">
            <label for="fechaHasta" class="form-label">Hasta</label>
            <input type="date" name="fechaHasta" id="fechaHasta" value="@(fechaHasta?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
        </div>
    </form>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var error in ViewData.ModelState.SelectMany(kvp => kvp.Value!.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    @if (fechaDesde == null || fechaHasta == null)
    {
        <div class="alert alert-info">Seleccione ambas fechas para buscar inmuebles disponibles.</div>
    }
    else if (!Model.Any())
    {
        <div class="alert alert-info">No hay inmuebles disponibles en ese rango de fechas.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Dirección</th>
                        <th>Propietario</th>
                        <th>Tipo</th>
                        <th>Precio por día</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inmueble in Model)
                    {
                        <tr>
                            <td>@inmueble.Direccion</td>
                            <td>@inmueble.propietarioNombre</td>
                            <td>@inmueble.TipoNombre</td>
                            <td>@inmueble.PrecioPorDia.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (totalPaginas > 1)
    {
        <nav class="mt-3" aria-label="Paginación de inmuebles disponibles">
            <ul class="pagination">
                @if (pagina > 1)
                {
                    <li class="page-item"><a class="page-link" asp-action="InmueblesDisponiblesEntreFechas" asp-route-fechaDesde="@fechaDesde?.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@fechaHasta?.ToString("yyyy-MM-dd")" asp-route-pagina="@(pagina - 1)">Anterior</a></li>
                }
                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == pagina ? "active" : "")"><a class="page-link" asp-action="InmueblesDisponiblesEntreFechas" asp-route-fechaDesde="@fechaDesde?.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@fechaHasta?.ToString("yyyy-MM-dd")" asp-route-pagina="@i">@i</a></li>
                }
                @if (pagina < totalPaginas)
                {
                    <li class="page-item"><a class="page-link" asp-action="InmueblesDisponiblesEntreFechas" asp-route-fechaDesde="@fechaDesde?.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@fechaHasta?.ToString("yyyy-MM-dd")" asp-route-pagina="@(pagina + 1)">Siguiente</a></li>
                }
            </ul>
        </nav>
    }
</div>
