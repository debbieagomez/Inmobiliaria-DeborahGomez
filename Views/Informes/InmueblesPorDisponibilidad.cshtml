@model IEnumerable<Inmobiliaria_DeborahGomez.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles por disponibilidad";
    bool? disponibleActual = ViewBag.Disponible;
    int pagina = ViewBag.Pagina ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 0;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Inmuebles por disponibilidad</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver a informes</a>
    </div>

    <form asp-action="InmueblesPorDisponibilidad" method="get" class="row g-2 mb-4">
        <div class="col-md-8">
            <select name="disponible" id="disponible" class="form-select">
                <option value="" selected="@(disponibleActual == null)">Todos</option>
                <option value="true" selected="@(disponibleActual == true)">Disponibles</option>
                <option value="false" selected="@(disponibleActual == false)">No disponibles</option>
            </select>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-outline-primary">Aplicar filtro</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No hay inmuebles para el filtro seleccionado.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Dirección</th>
                        <th>Propietario</th>
                        <th>Tipo</th>
                        <th>Precio por día</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inmueble in Model)
                    {
                        <tr>
                            <td>@inmueble.Direccion</td>
                            <td>@inmueble.propietarioNombre</td>
                            <td>@inmueble.TipoNombre</td>
                            <td>@inmueble.PrecioPorDia.ToString("C")</td>
                            <td>
                                @if (inmueble.Disponible)
                                {
                                    <span class="badge bg-success">Disponible</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Suspendido</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (totalPaginas > 1)
    {
        <nav class="mt-3" aria-label="Paginación de inmuebles por disponibilidad">
            <ul class="pagination">
                @if (pagina > 1)
                {
                    <li class="page-item"><a class="page-link" asp-action="InmueblesPorDisponibilidad" asp-route-disponible="@disponibleActual" asp-route-pagina="@(pagina - 1)">Anterior</a></li>
                }
                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == pagina ? "active" : "")"><a class="page-link" asp-action="InmueblesPorDisponibilidad" asp-route-disponible="@disponibleActual" asp-route-pagina="@i">@i</a></li>
                }
                @if (pagina < totalPaginas)
                {
                    <li class="page-item"><a class="page-link" asp-action="InmueblesPorDisponibilidad" asp-route-disponible="@disponibleActual" asp-route-pagina="@(pagina + 1)">Siguiente</a></li>
                }
            </ul>
        </nav>
    }
</div>
