@model IEnumerable<Inmobiliaria_DeborahGomez.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles y su dueño";
    bool? disponibleActual = ViewBag.Disponible;
    int pagina = ViewBag.Pagina;
    int totalPaginas = ViewBag.TotalPaginas;
}

<h2>Inmuebles y su dueño</h2>

<form asp-action="InmueblesPorDisponibilidad" method="get" class="mb-3">
    <label for="disponible">Filtrar por disponibilidad:</label>
    <select name="disponible" id="disponible" onchange="this.form.submit()">
        <option value="" selected="@(disponibleActual == null)">Todos</option>
        <option value="true" selected="@(disponibleActual == true)">Disponibles</option>
        <option value="false" selected="@(disponibleActual == false)">No disponibles</option>
    </select>
</form>

<table>
    <thead>
        <tr>
            <th>Dirección</th>
            <th>Propietario</th>
            <th>Tipo</th>
            <th>Precio por día</th>
            <th>Disponible</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var inmueble in Model)
        {
            <tr>
                <td>@inmueble.Direccion</td>
                <td>@inmueble.propietarioNombre</td>
                <td>@inmueble.TipoNombre</td>
                <td>@inmueble.PrecioPorDia</td>
                <td>@(inmueble.Disponible ? "Sí" : "No")</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    @if (pagina > 1)
    {
        <a asp-action="InmueblesPorDisponibilidad" asp-route-disponible="@disponibleActual" asp-route-pagina="@(pagina - 1)">Anterior</a>
    }
    <span> Página @pagina de @totalPaginas </span>
    @if (pagina < totalPaginas)
    {
        <a asp-action="InmueblesPorDisponibilidad" asp-route-disponible="@disponibleActual" asp-route-pagina="@(pagina + 1)">Siguiente</a>
    }
</div>

<a asp-action="Index">Volver a Informes</a>