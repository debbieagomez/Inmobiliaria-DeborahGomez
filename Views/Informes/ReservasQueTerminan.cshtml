@model IEnumerable<Inmobiliaria_DeborahGomez.Models.Reserva>

@{
    ViewData["Title"] = "Reservas que terminan";
    int dias = ViewBag.Dias;
    int pagina = ViewBag.Pagina;
    int totalPaginas = ViewBag.TotalPaginas;
}

<div class="container mt-4">

    <h2>Reservas que terminan</h2>

    <form asp-action="ReservasQueTerminan"
          method="get"
          class="row g-2 mb-4">

        <div class="col-md-3">

            <label for="dias"
                   class="form-label">
                Próximos días
            </label>

            <input type="number"
                   id="dias"
                   name="dias"
                   value="@dias"
                   min="1"
                   class="form-control" />

        </div>

        <div class="col-md-3 d-flex align-items-end">

            <button type="submit"
                    class="btn btn-primary">
                Buscar
            </button>

        </div>

    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No hay reservas que terminen dentro de los próximos @dias días.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover">

                <thead>
                    <tr>
                        <th>Reserva</th>
                        <th>Inmueble</th>
                        <th>Inquilino</th>
                        <th>Desde</th>
                        <th>Hasta</th>
                        <th>Monto por día</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var reserva in Model)
                    {
                        <tr>
                            <td>
                                #@reserva.IdReserva
                            </td>

                            <td>
                                @reserva.DireccionInmueble
                            </td>

                            <td>
                                @reserva.NombreInquilino
                            </td>

                            <td>
                                @reserva.FechaDesde.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @reserva.FechaHasta.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                $ @reserva.MontoPorDia.ToString("N2")
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="mt-3">

            <span>
                Página @pagina de @totalPaginas
            </span>

            @if (pagina > 1)
            {
                <a asp-action="ReservasQueTerminan"
                   asp-route-dias="@dias"
                   asp-route-pagina="@(pagina - 1)"
                   class="btn btn-outline-secondary ms-2">
                    Anterior
                </a>
            }

            @if (pagina < totalPaginas)
            {
                <a asp-action="ReservasQueTerminan"
                   asp-route-dias="@dias"
                   asp-route-pagina="@(pagina + 1)"
                   class="btn btn-outline-secondary ms-2">
                    Siguiente
                </a>
            }

        </div>
    }

    <a asp-action="Index"
       class="btn btn-secondary mt-3">
        Volver
    </a>

</div>