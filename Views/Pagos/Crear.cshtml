@model Inmobiliaria_DeborahGomez.Models.Pago

@{
    ViewData["Title"] = "Nuevo pago";

    var reserva =
        ViewBag.Reserva as Inmobiliaria_DeborahGomez.Models.Reserva;
}

<div class="container mt-4">

    <h1>Nuevo pago</h1>

    @if (reserva != null)
    {
        <div class="alert alert-info">
            Reserva #@reserva.IdReserva
        </div>
    }

    <form asp-action="Crear"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="ReservaId" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">

            <label asp-for="Concepto"
                   class="form-label">
            </label>

            <input asp-for="Concepto"
                   class="form-control" />

            <span asp-validation-for="Concepto"
                  class="text-danger">
            </span>

        </div>

        <div class="mb-3">

            <label asp-for="FechaPago"
                   class="form-label">
            </label>

            <input asp-for="FechaPago"
                   type="datetime-local"
                   class="form-control" />

            <span asp-validation-for="FechaPago"
                  class="text-danger">
            </span>

        </div>

        <div class="mb-3">

            <label asp-for="Importe"
                   class="form-label">
            </label>

            <input asp-for="Importe"
                   type="number"
                   step="0.01"
                   class="form-control" />

            <span asp-validation-for="Importe"
                  class="text-danger">
            </span>

        </div>

        <button type="submit"
                class="btn btn-primary">
            Guardar
        </button>

        <a asp-action="Index"
           asp-route-reservaId="@Model.ReservaId"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}