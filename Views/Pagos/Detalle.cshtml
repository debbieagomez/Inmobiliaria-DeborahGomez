@model Inmobiliaria_DeborahGomez.Models.Pago

@{
    ViewData["Title"] = "Detalle del pago";
}

<div class="container mt-4">

    <h1>Detalle del pago #@Model.IdPago</h1>

    <div class="card">

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-4">
                    Concepto
                </dt>

                <dd class="col-sm-8">
                    @Model.Concepto
                </dd>


                <dt class="col-sm-4">
                    Fecha de pago
                </dt>

                <dd class="col-sm-8">
                    @Model.FechaPago.ToString(
                        "dd/MM/yyyy HH:mm"
                    )
                </dd>


                <dt class="col-sm-4">
                    Importe
                </dt>

                <dd class="col-sm-8">
                    $ @Model.Importe.ToString("N2")
                </dd>


                <dt class="col-sm-4">
                    Estado
                </dt>

                <dd class="col-sm-8">

                    @if (Model.Anulado)
                    {
                        <span class="badge bg-danger">
                            Anulado
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            Vigente
                        </span>
                    }

                </dd>


                <dt class="col-sm-4">
                    Reserva
                </dt>

                <dd class="col-sm-8">
                    @Model.ReservaId
                </dd>

                @if (User.IsInRole("Administrador"))
                {
                    <dt class="col-sm-4">
                        Usuario creador
                    </dt>

                    <dd class="col-sm-8">
                        @Model.UsuarioCreadorId
                    </dd>


                    <dt class="col-sm-4">
                        Usuario anulador
                    </dt>

                    <dd class="col-sm-8">
                        @(Model.UsuarioAnuladorId?.ToString() ?? "No anulado")
                    </dd>


                    <dt class="col-sm-4">
                        Fecha de anulación
                    </dt>

                    <dd class="col-sm-8">
                        @(Model.FechaAnulacion?.ToString(
                            "dd/MM/yyyy HH:mm"
                        ) ?? "No anulado")
                    </dd>
                }

            </dl>

        </div>

    </div>

    <div class="mt-3">

        <a asp-action="Index"
           asp-route-reservaId="@Model.ReservaId"
           class="btn btn-secondary">
            Volver
        </a>

    </div>

</div>