@model IList<Inmobiliaria_DeborahGomez.Models.Pago>

@{
    ViewData["Title"] = "Pagos";

    var reserva =
        ViewBag.Reserva as Inmobiliaria_DeborahGomez.Models.Reserva;

    int reservaId = ViewBag.ReservaId ?? 0;
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int cantidad = ViewBag.Cantidad ?? 0;

    string? busqueda = ViewBag.Busqueda;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h1>Pagos de la reserva</h1>

            @if (reserva != null)
            {
                <p class="text-muted mb-0">
                    Reserva #@reserva.IdReserva
                </p>
            }
        </div>

        <a asp-action="Crear"
           asp-route-reservaId="@reservaId"
           class="btn btn-primary">
            Nuevo pago
        </a>

    </div>

    <form asp-action="Index"
          method="get"
          class="row g-2 mb-4">

        <input type="hidden"
               name="reservaId"
               value="@reservaId" />

        <div class="col-md-8">

            <input type="text"
                   name="busqueda"
                   value="@busqueda"
                   class="form-control"
                   placeholder="Buscar por concepto..." />

        </div>

        <div class="col-md-4">

            <button type="submit"
                    class="btn btn-outline-primary">
                Buscar
            </button>

            <a asp-action="Index"
               asp-route-reservaId="@reservaId"
               class="btn btn-outline-secondary">
                Limpiar
            </a>

        </div>

    </form>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="mb-3">
        <strong>Total de pagos:</strong> @cantidad
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No hay pagos registrados para esta reserva.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">

                <thead>
                    <tr>

                        <th>Concepto</th>
                        <th>Fecha</th>
                        <th>Importe</th>
                        <th>Estado</th>

                        @if (User.IsInRole("Administrador"))
                        {
                            <th>Auditoría</th>
                        }

                        <th></th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var pago in Model)
                    {
                        <tr>

                            <td>
                                @pago.Concepto
                            </td>

                            <td>
                                @pago.FechaPago.ToString(
                                    "dd/MM/yyyy HH:mm"
                                )
                            </td>

                            <td>
                                $ @pago.Importe.ToString("N2")
                            </td>

                            <td>

                                @if (pago.Anulado)
                                {
                                    <span class="badge bg-danger">
                                        Anulado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Vigente
                                    </span>
                                }

                            </td>

                            @if (User.IsInRole("Administrador"))
                            {
                                <td>
                                    <small>

                                        Creador:
                                        @pago.UsuarioCreadorId

                                        <br />

                                        @if (pago.Anulado)
                                        {
                                            <span>
                                                Anulador:
                                                @(pago.UsuarioAnuladorId?.ToString() ?? "-")
                                            </span>

                                            <br />

                                            <span>
                                                Fecha anulación:
                                                @(pago.FechaAnulacion?.ToString(
                                                    "dd/MM/yyyy HH:mm"
                                                ) ?? "-")
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                Anulador: -
                                            </span>
                                        }

                                    </small>
                                </td>
                            }

                            <td>

                                <a asp-action="Detalle"
                                   asp-route-id="@pago.IdPago"
                                   class="btn btn-sm btn-outline-secondary">
                                    Detalle
                                </a>

                                @if (!pago.Anulado)
                                {
                                    <a asp-action="Editar"
                                       asp-route-id="@pago.IdPago"
                                       class="btn btn-sm btn-outline-primary">
                                        Editar
                                    </a>

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <form asp-action="Anular"
                                              asp-route-id="@pago.IdPago"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('¿Seguro que desea anular este pago?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Anular
                                            </button>

                                        </form>
                                    }
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    @if (totalPaginas > 1)
    {
        <nav>

            <ul class="pagination">

                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == paginaActual ? "active" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-reservaId="@reservaId"
                           asp-route-busqueda="@busqueda"
                           asp-route-pagina="@i">

                            @i

                        </a>

                    </li>
                }

            </ul>

        </nav>
    }

</div>