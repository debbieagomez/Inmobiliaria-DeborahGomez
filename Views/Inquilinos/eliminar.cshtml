@model Inmobiliaria_DeborahGomez.Models.Inquilino

@{
    ViewData["Title"] = "Eliminar inquilino";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h1 class="h3 mb-4">Eliminar inquilino</h1>
            <div class="alert alert-warning">¿Está seguro de que desea eliminar este inquilino?</div>

            <dl class="row">
                <dt class="col-sm-3">DNI</dt>
                <dd class="col-sm-9">@Model.Dni</dd>
                <dt class="col-sm-3">Nombre completo</dt>
                <dd class="col-sm-9">@Model.NombreCompleto</dd>
                <dt class="col-sm-3">Teléfono</dt>
                <dd class="col-sm-9">@Model.Telefono</dd>
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>
            </dl>

            <form asp-action="EliminarConfirmado" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.IdInquilino" />
                <button type="submit" class="btn btn-danger">Eliminar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>
