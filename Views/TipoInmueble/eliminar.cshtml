@model Inmobiliaria_DeborahGomez.Models.TipoInmueble

@{
    ViewData["Title"] = "Eliminar tipo de inmueble";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h1 class="h3 mb-4">Eliminar tipo de inmueble</h1>
            <div class="alert alert-warning">¿Está seguro de que desea eliminar este tipo de inmueble?</div>

            <dl class="row">
                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">@Model.Nombre</dd>
            </dl>

            <form asp-action="EliminarConfirmado" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.IdTipoInmueble" />
                <button type="submit" class="btn btn-danger">Eliminar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>
