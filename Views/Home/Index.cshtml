@{
    ViewData["Title"] = "Inicio";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1>Panel de la Agencia</h1>
        
        @if (User.Identity?.IsAuthenticated == true)
        {
            <p class="text-muted">Bienvenido/a, @User.Identity.Name</p>
        }
        else
        {
            <p class="text-muted">
                <a asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a> para acceder al sistema.
            </p>
        }
    </div>

    <div class="row g-3">

        <div class="col-md-4">
            <a asp-controller="Propietarios" asp-action="Index" class="btn btn-outline-primary w-100 py-4">
                Propietarios
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Inquilinos" asp-action="Index" class="btn btn-outline-primary w-100 py-4">
                Inquilinos
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="TipoInmueble" asp-action="Index" class="btn btn-outline-primary w-100 py-4">
                Tipos de Inmueble
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Inmuebles" asp-action="Index" class="btn btn-outline-primary w-100 py-4">
                Inmuebles
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Reservas" asp-action="Index" class="btn btn-outline-primary w-100 py-4">
                Reservas
            </a>
        </div>

        @if (User.IsInRole("Administrador"))
        {
            <div class="col-md-4">
                <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-secondary w-100 py-4">
                    Usuarios
                </a>
            </div>
        }

    </div>

</div>