@model IEnumerable<Inmobiliaria_DeborahGomez.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles";
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int cantidad = ViewBag.Cantidad ?? 0;
    string? busqueda = ViewBag.Busqueda;
}

<div class="container mt-4">
    @if (TempData["Error_Inmuebles"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Inmuebles</h1>
        <a asp-action="Crear" class="btn btn-primary">Nuevo inmueble</a>
    </div>

    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-md-8">
            <input type="text" name="busqueda" value="@busqueda" class="form-control" placeholder="Buscar por dirección, propietario o tipo..." />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    <div class="mb-3"><strong>Total de inmuebles:</strong> @cantidad</div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No hay inmuebles registrados.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Imagen</th>
                        <th>ID</th>
                        <th>Dirección</th>
                        <th>Tipo</th>
                        <th>Propietario</th>
                        <th>Cupo</th>
                        <th>Precio</th>
                        <th>Disponible</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inmueble in Model)
                    {
                        var portada = inmueble.Imagenes.FirstOrDefault(i => i.EsPortada);
                        <tr>
                            <td>
                                @if (portada != null)
                                {
                                    <img src="@portada.Url" alt="Portada del inmueble" style="width:120px;height:80px;object-fit:cover;" />
                                }
                                else
                                {
                                    <span class="text-muted">Sin imagen</span>
                                }
                            </td>
                            <td>@inmueble.IdInmueble</td>
                            <td>@inmueble.Direccion</td>
                            <td>@inmueble.TipoNombre</td>
                            <td>@inmueble.propietarioNombre</td>
                            <td>@inmueble.Cupo</td>
                            <td>@inmueble.PrecioPorDia.ToString("C")</td>
                            <td>
                                @if (inmueble.Disponible)
                                {
                                    <span class="badge bg-success">Disponible</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Suspendido</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Detalle" asp-route-id="@inmueble.IdInmueble" class="btn btn-sm btn-outline-info">Detalle</a>
                                <a asp-action="Editar" asp-route-id="@inmueble.IdInmueble" class="btn btn-sm btn-outline-primary">Editar</a>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Eliminar" asp-route-id="@inmueble.IdInmueble" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (totalPaginas > 1)
    {
        <nav class="mt-3" aria-label="Paginación de inmuebles">
            <ul class="pagination">
                @if (paginaActual > 1)
                {
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)" asp-route-busqueda="@busqueda">Anterior</a></li>
                }
                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == paginaActual ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-busqueda="@busqueda">@i</a></li>
                }
                @if (paginaActual < totalPaginas)
                {
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)" asp-route-busqueda="@busqueda">Siguiente</a></li>
                }
            </ul>
        </nav>
    }
</div>
