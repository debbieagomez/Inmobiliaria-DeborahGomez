@model Inmobiliaria_DeborahGomez.Models.Reserva

@{
    ViewData["Title"] = "Nueva reserva";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h1 class="h3 mb-4">Nueva reserva</h1>

            <form asp-controller="Reservas" asp-action="Crear" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div>
                    <label asp-for="FechaDesde"></label>
                    <input asp-for="FechaDesde" type="date" />
                    <span asp-validation-for="FechaDesde" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="FechaHasta"></label>
                    <input asp-for="FechaHasta" type="date" />
                    <span asp-validation-for="FechaHasta" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MontoPorDia" class="form-label"></label>
                    <input asp-for="MontoPorDia" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="MontoPorDia" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="InmuebleId" class="form-label">Inmueble</label>
                    <select asp-for="InmuebleId" class="form-select">
                        <option value="0">Seleccione un inmueble</option>
                        @foreach (var inmueble in (IEnumerable<Inmobiliaria_DeborahGomez.Models.Inmueble>)ViewBag.Inmuebles)
                        {
                            <option value="@inmueble.IdInmueble">@inmueble.Direccion</option>
                        }
                    </select>
                    <span asp-validation-for="InmuebleId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="InquilinoId" class="form-label">Inquilino</label>
                    <select asp-for="InquilinoId" class="form-select">
                        <option value="0">Seleccione un inquilino</option>
                        @foreach (var inquilino in (IEnumerable<Inmobiliaria_DeborahGomez.Models.Inquilino>)ViewBag.Inquilinos)
                        {
                            <option value="@inquilino.IdInquilino">@inquilino.NombreCompleto</option>
                        }
                    </select>
                    <span asp-validation-for="InquilinoId" class="text-danger"></span>
                </div>

                <input asp-for="Finalizada" type="hidden" value="false" />

                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
