@model Inmobiliaria_DeborahGomez.Models.Reserva

<h1>Nueva Reserva</h1>

<form asp-controller="Reservas" asp-action="Crear" method="post">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div>
        <label asp-for="FechaDesde"></label>
        <input asp-for="FechaDesde" type="datetime-local" />
        <span asp-validation-for="FechaDesde" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="FechaHasta"></label>
        <input asp-for="FechaHasta" type="datetime-local" />
        <span asp-validation-for="FechaHasta" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="MontoPorDia"></label>
        <input asp-for="MontoPorDia" type="number" step="0.01" />
        <span asp-validation-for="MontoPorDia" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="InmuebleId"></label>

        <select asp-for="InmuebleId">

            <option value="0">Seleccione un inmueble</option>

            @foreach (var inmueble in
                (IEnumerable<Inmobiliaria_DeborahGomez.Models.Inmueble>)ViewBag.Inmuebles)
            {
                <option value="@inmueble.IdInmueble">
                    @inmueble.Direccion
                </option>
            }

        </select>

        <span asp-validation-for="InmuebleId" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="InquilinoId"></label>

        <select asp-for="InquilinoId">

            <option value="0">Seleccione un inquilino</option>

            @foreach (var inquilino in
                (IEnumerable<Inmobiliaria_DeborahGomez.Models.Inquilino>)ViewBag.Inquilinos)
            {
                <option value="@inquilino.IdInquilino">
                    @inquilino.NombreCompleto
                </option>
            }

        </select>

        <span asp-validation-for="InquilinoId" class="text-danger"></span>
    </div>

    <input asp-for="Finalizada" type="hidden" value="false" />

    <input asp-for="UsuarioCreadorId" type="hidden" value="1" />

    <button type="submit">Guardar</button>

    <a asp-action="Index">Cancelar</a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}