@model Inmobiliaria_DeborahGomez.Models.Reserva

<h1>Eliminar Reserva</h1>

<h3>¿Está seguro que desea eliminar esta reserva?</h3>

<div>
    <p><strong>Id:</strong> @Model.IdReserva</p>
    <p><strong>Desde:</strong> @Model.FechaDesde</p>
    <p><strong>Hasta:</strong> @Model.FechaHasta</p>
    <p><strong>Monto por día:</strong> @Model.MontoPorDia</p>
    <p><strong>Inmueble:</strong> @Model.InmuebleId</p>
    <p><strong>Inquilino:</strong> @Model.InquilinoId</p>
</div>

<form asp-controller="Reservas" asp-action="EliminarConfirmado" method="post">

    <input type="hidden" asp-for="IdReserva" />

    <button type="submit">Eliminar</button>

    <a asp-action="Index">Cancelar</a>

</form>