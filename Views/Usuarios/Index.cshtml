@model IList<Inmobiliaria_DeborahGomez.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Usuarios</h2>

        <a asp-action="Crear"
           class="btn btn-primary">
            Nuevo usuario
        </a>
    </div>

    <form method="get"
          asp-action="Index"
          class="mb-3">

        <div class="input-group">
            <input type="text"
                   name="busqueda"
                   value="@ViewBag.Busqueda"
                   class="form-control"
                   placeholder="Buscar por email o rol" />

            <button type="submit"
                    class="btn btn-outline-secondary">
                Buscar
            </button>
        </div>
    </form>

    <table class="table table-striped">

        <thead>
            <tr>
                <th>ID</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>

        @foreach (var usuario in Model)
        {
            <tr>
                <td>@usuario.IdUsuario</td>
                <td>@usuario.Email</td>
                <td>@usuario.Rol</td>

                <td>
                    <a asp-action="Editar"
                       asp-route-id="@usuario.IdUsuario"
                       class="btn btn-sm btn-warning">
                        Editar
                    </a>

                    <a asp-action="Eliminar"
                       asp-route-id="@usuario.IdUsuario"
                       class="btn btn-sm btn-danger">
                        Eliminar
                    </a>
                </td>
            </tr>
        }

        </tbody>
    </table>

    <div class="mt-3">

        Página @ViewBag.PaginaActual
        de @ViewBag.TotalPaginas

        <div class="mt-2">

            @if (ViewBag.PaginaActual > 1)
            {
                <a asp-action="Index"
                   asp-route-pagina="@(ViewBag.PaginaActual - 1)"
                   asp-route-busqueda="@ViewBag.Busqueda"
                   class="btn btn-outline-secondary">
                    Anterior
                </a>
            }

            @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
            {
                <a asp-action="Index"
                   asp-route-pagina="@(ViewBag.PaginaActual + 1)"
                   asp-route-busqueda="@ViewBag.Busqueda"
                   class="btn btn-outline-secondary">
                    Siguiente
                </a>
            }

        </div>
    </div>

</div>